===== osg-probe/heartbeat.sh
     1	#!/bin/bash
     2	# PIA heartbeat: log OSG status every 11 min; if OSG is down -> wake my pi pane via herdr
     3	TS=$(date '+%F %T')
     4	CODE=$(curl -s -o /dev/null -w '%{http_code}' --max-time 4 http://localhost:3030/sap/bc/adt/discovery 2>/dev/null)
     5	PID=$(pgrep -f "test/run.mjs" | head -1)
     6	echo "$TS osg_discovery=$CODE pid=${PID:-none}" >> /home/alice/dev/pia/osg-probe/heartbeat.log
     7	if [ "$CODE" != "200" ]; then
     8	  ~/.local/bin/herdr pane run w4:p1 "[timer:11m] OSG discovery=$CODE pid=${PID:-none} — сервер не отвечает; проверь /tmp/osd.log, при необходимости рестартни в ~/dev/osg-adt-abap" 2>/dev/null
     9	fi
