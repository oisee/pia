    39	    DATA(ls) = mo_backend->write_source( iv_name = lv_name iv_source = lv_source ).
    40	    IF ls-ok = abap_false.
    41	      rs_ = fail( ls-message ).
    42	      RETURN.
    43	    ENDIF.
    44	    rs_ = ok( ls-message && '. NOTE: activation is a separate step (activate tool).' ).
    45	  ENDMETHOD.
