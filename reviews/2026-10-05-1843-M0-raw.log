===== src/00/zcl_pia_00_json_util.clas.abap
     1	CLASS zcl_pia_00_json_util DEFINITION PUBLIC FINAL CREATE PUBLIC.
     2	
     3	  PUBLIC SECTION.
     4	    CLASS-METHODS escape
     5	      IMPORTING iv_         TYPE string
     6	      RETURNING VALUE(rv_)  TYPE string.
     7	
     8	    CLASS-METHODS extract_str
     9	      IMPORTING iv_json     TYPE string
    10	                iv_name     TYPE string
    11	      RETURNING VALUE(rv_)  TYPE string.
    12	
    13	    CLASS-METHODS extract_int
    14	      IMPORTING iv_json     TYPE string
    15	                iv_name     TYPE string
    16	      RETURNING VALUE(rv_)  TYPE i.
    17	
    18	    CLASS-METHODS extract_balanced
    19	      IMPORTING iv_json     TYPE string
    20	                iv_key      TYPE string
    21	                iv_open     TYPE string
    22	                iv_close    TYPE string
    23	      RETURNING VALUE(rv_)  TYPE string.
    24	
    25	ENDCLASS.
    26	
    27	CLASS zcl_pia_00_json_util IMPLEMENTATION.
    28	
    29	  METHOD escape.
    30	    rv_ = iv_.
    31	    REPLACE ALL OCCURRENCES OF `\` IN rv_ WITH `\\`.
    32	    REPLACE ALL OCCURRENCES OF `"` IN rv_ WITH `\"`.
    33	    REPLACE ALL OCCURRENCES OF |\n| IN rv_ WITH `\n`.
    34	    REPLACE ALL OCCURRENCES OF |\r| IN rv_ WITH `\r`.
    35	    REPLACE ALL OCCURRENCES OF |\t| IN rv_ WITH `\t`.
    36	  ENDMETHOD.
    37	
    38	  METHOD extract_str.
    39	    DATA(lv_re) = '"' && iv_name && '"\s*:\s*"((?:[^"\\]|\\.)*)"'.
    40	    FIND FIRST OCCURRENCE OF REGEX lv_re IN iv_json SUBMATCHES rv_.
    41	  ENDMETHOD.
    42	
    43	  METHOD extract_int.
    44	    FIND FIRST OCCURRENCE OF REGEX |"{ iv_name }"\s*:\s*(-?\d+)|
    45	      IN iv_json SUBMATCHES DATA(lv).
    46	    rv_ = CONV #( lv ).
    47	  ENDMETHOD.
    48	
    49	  METHOD extract_balanced.
    50	    DATA lv_off TYPE i.
    51	    FIND |"{ iv_key }"| IN iv_json MATCH OFFSET lv_off.
    52	    IF sy-subrc <> 0. RETURN. ENDIF.
    53	    DATA(lv_rest) = iv_json + lv_off.
    54	    DATA lv_start TYPE i.
    55	    FIND FIRST OCCURRENCE OF iv_open IN lv_rest MATCH OFFSET lv_start.
    56	    IF sy-subrc <> 0. RETURN. ENDIF.
    57	    DATA lv_depth TYPE i VALUE 1.
    58	    DATA lv_pos TYPE i VALUE lv_start.
    59	    WHILE lv_pos < strlen( lv_rest ) - 1 AND lv_depth > 0.
    60	      lv_pos = lv_pos + 1.
    61	      IF lv_rest+lv_pos(1) = iv_open.
    62	        lv_depth = lv_depth + 1.
    63	      ELSEIF lv_rest+lv_pos(1) = iv_close.
    64	        lv_depth = lv_depth - 1.
    65	      ENDIF.
    66	    ENDWHILE.
    67	    DATA(lv_len) = lv_pos - lv_start + 1.
    68	    rv_ = lv_rest+lv_start(lv_len).
    69	  ENDMETHOD.
    70	
    71	ENDCLASS.
