===== src/00/zcl_pia_00_llm_http.clas.abap
     1	CLASS zcl_pia_00_llm_http DEFINITION PUBLIC FINAL CREATE PUBLIC.
     2	
     3	  PUBLIC SECTION.
     4	    INTERFACES zif_pia_00_llm.
     5	
     6	    CLASS-METHODS new
     7	      IMPORTING is_config     TYPE zif_pia_00_llm=>ts_config
     8	      RETURNING VALUE(ro_)    TYPE REF TO zcl_pia_00_llm_http.
     9	
    10	  PRIVATE SECTION.
    11	    DATA ms_config TYPE zif_pia_00_llm=>ts_config.
    12	
    13	    METHODS build_messages_json
    14	      IMPORTING it_messages   TYPE zcl_pia_00_session=>tt_messages
    15	      RETURNING VALUE(rv_)    TYPE string.
    16	
    17	ENDCLASS.
    18	
    19	CLASS zcl_pia_00_llm_http IMPLEMENTATION.
    20	
    21	  METHOD new.
    22	    ro_ = NEW #( ).
    23	    ro_->ms_config = is_config.
    24	  ENDMETHOD.
    25	
    26	  METHOD build_messages_json.
    27	    DATA lt TYPE string_table.
    28	    LOOP AT it_messages INTO DATA(ls).
    29	      IF ls-role = 'assistant' AND ls-content CP '{"tool_calls"*'.
    30	        " content starts with {"tool_calls": (14 chars); re-embed properly
    31	        APPEND '{"role":"assistant","tool_calls":' && ls-content+14 && '}' TO lt.
    32	      ELSEIF ls-role = 'tool'.
    33	        " content is the raw tail: "tool_call_id":..,"content":..
    34	        APPEND '{"role":"tool",' && ls-content && '}' TO lt.
    35	      ELSE.
    36	        APPEND '{"role":"' && ls-role && '","content":"' &&
    37	               zcl_pia_00_json_util=>escape( ls-content ) && '"}' TO lt.
    38	      ENDIF.
    39	    ENDLOOP.
    40	    rv_ = '[' && concat_lines_of( table = lt sep = ',' ) && ']'.
    41	  ENDMETHOD.
    42	
    43	  METHOD zif_pia_00_llm~chat.
    44	    DATA li TYPE REF TO if_http_client.
    45	    cl_http_client=>create_by_url(
    46	      EXPORTING url = ms_config-base_url
    47	      IMPORTING client = li ).
    48	
    49	    DATA(lv_tools) = ``.
    50	    IF iv_tools_json IS NOT INITIAL.
    51	      lv_tools = |,"tools":{ iv_tools_json }|.
    52	    ENDIF.
    53	
    54	    DATA(lv_body) = |{{"model":"{ ms_config-model }","stream":false,' &&
    55	                     |"messages":{ build_messages_json( it_messages ) }{ lv_tools }}}|.
    56	
    57	    li->request->set_method( 'POST' ).
    58	    li->request->set_header_field( name = 'content-type' value = 'application/json' ).
    59	    IF ms_config-api_key IS NOT INITIAL.
    60	      li->request->set_header_field( name = 'authorization'
    61	        value = |Bearer { ms_config-api_key }| ).
    62	    ENDIF.
    63	    li->request->set_cdata( lv_body ).
    64	    li->send( ).
    65	    li->receive( ).
    66	    li->response->get_status( IMPORTING code = ev_status ).
    67	    ev_body = li->response->get_cdata( ).
    68	    IF ev_status <> 200.
    69	      ev_error = |HTTP { ev_status }: { ev_body }|.
    70	    ENDIF.
    71	  ENDMETHOD.
    72	
    73	ENDCLASS.
