    32	    DATA(lv_name)   = get_arg( iv_name = 'name'   iv_arguments = iv_arguments ).
    33	    " source may contain escaped quotes etc: extract via balanced string with escape-aware regex
    34	    DATA(lv_source) = zcl_pia_00_json_util=>extract_str( iv_json = iv_arguments iv_name = 'source' ).
    35	    IF lv_name IS INITIAL OR lv_source IS INITIAL.
