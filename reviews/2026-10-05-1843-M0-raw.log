     4	ENDCLASS.
     5	
     6	CLASS zcl_pia_90_mock_run IMPLEMENTATION.
     7	  METHOD if_oo_adt_classrun~main.
     8	    out->write( `PIA M1: mock loop` ).
     9	    DATA(lo_backend) = zcl_pia_20_b_osg_store=>new( ).
    10	    DATA(lo_registry) = zcl_pia_00_registry=>new( ).
    11	    DATA(lo_read) = NEW zcl_pia_10_t_read_object( ).
    12	    lo_read->set_backend( lo_backend ).
    13	    lo_registry->register( lo_read ).
    14	    DATA(lo_llm) = zcl_pia_00_llm_mock=>new( ).
    15	    lo_llm->add_response( '{"choices":[{"message":{"role":"assistant","content":"","tool_calls":[{"id":"c1","type":"function","function":{"name":"read_object","arguments":"{\\"name\\":\\"ZCL_PIA_DEMO\\"}"}}]},"finish_reason":"tool_calls"}]}' ).
    16	    lo_llm->add_response( '{"choices":[{"message":{"role":"assistant","content":"","tool_calls":[{"id":"c2","type":"function","function":{"name":"write_source","arguments":"{\\"name\\":\\"ZCL_PIA_DEMO\\",\\"source\\":\\"fixed\\"}"}}]},"finish_reason":"tool_calls"}]}' ).
    17	    lo_llm->add_response( '{"choices":[{"message":{"role":"assistant","content":"","tool_calls":[{"id":"c3","type":"function","function":{"name":"activate","arguments":"{\\"name\\":\\"ZCL_PIA_DEMO\\"}"}}]},"finish_reason":"tool_calls"}]}' ).
    18	    lo_llm->add_response( '{"choices":[{"message":{"role":"assistant","content":"mock done: fixed and activated"},"finish_reason":"stop"}]}' ).
    19	    DATA(lo_session) = zcl_pia_00_session=>new( |mock fix| ).
    20	    DATA(lo_exec) = zcl_pia_00_executor=>new( io_llm = lo_llm io_registry = lo_registry io_session = lo_session ).
    21	    DATA(ls) = lo_exec->run( iv_task = |fix demo| iv_system = |sys| iv_max_iterations = 6 ).
    22	    out->write( |ANSWER: { ls-answer } ok={ ls-ok } err={ ls-error } tools={ ls-tool_calls }| ).
    23	    LOOP AT lo_session->get_trace( ) INTO DATA(ls_t).
    24	      out->write( |[{ ls_t-tool }] ok={ ls_t-ok }: { ls_t-output }| ).
    25	    ENDLOOP.
    26	  ENDMETHOD.
    27	ENDCLASS.
