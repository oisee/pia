     2	
     3	  TYPES: BEGIN OF ts_param,
     4	           name     TYPE string,
     5	           type     TYPE string,
     6	           desc     TYPE string,
     7	           required TYPE abap_bool,
     8	         END OF ts_param.
     9	  TYPES tt_params TYPE STANDARD TABLE OF ts_param WITH EMPTY KEY.
