===== src/00/zcl_pia_00_executor.clas.abap
     1	CLASS zcl_pia_00_executor DEFINITION PUBLIC FINAL CREATE PUBLIC.
     2	
     3	  PUBLIC SECTION.
     4	    TYPES: BEGIN OF ts_result,
     5	             answer     TYPE string,
     6	             iterations TYPE i,
     7	             tool_calls TYPE i,
     8	             ok         TYPE abap_bool,
     9	             error      TYPE string,
    10	           END OF ts_result.
    11	
    12	    CLASS-METHODS new
    13	      IMPORTING io_llm       TYPE REF TO zif_pia_00_llm
    14	                io_registry  TYPE REF TO zcl_pia_00_registry
    15	                io_session   TYPE REF TO zcl_pia_00_session
    16	      RETURNING VALUE(ro_)   TYPE REF TO zcl_pia_00_executor.
    17	
    18	    METHODS run
    19	      IMPORTING iv_task           TYPE string
    20	                iv_system         TYPE string
    21	                iv_max_iterations TYPE i DEFAULT 8
    22	      RETURNING VALUE(rs_)        TYPE ts_result.
    23	
    24	  PRIVATE SECTION.
    25	    DATA mo_llm      TYPE REF TO zif_pia_00_llm.
    26	    DATA mo_registry TYPE REF TO zcl_pia_00_registry.
    27	    DATA mo_session  TYPE REF TO zcl_pia_00_session.
    28	
    29	    METHODS parse_tool_calls
    30	      IMPORTING iv_body      TYPE string
    31	      RETURNING VALUE(rt_)   TYPE zif_pia_00_tool=>tt_calls.
    32	
    33	    METHODS extract_answer
    34	      IMPORTING iv_body      TYPE string
    35	      RETURNING VALUE(rv_)   TYPE string.
    36	
    37	ENDCLASS.
    38	
    39	CLASS zcl_pia_00_executor IMPLEMENTATION.
    40	
    41	  METHOD new.
    42	    ro_ = NEW #( ).
    43	    ro_->mo_llm = io_llm.
    44	    ro_->mo_registry = io_registry.
    45	    ro_->mo_session = io_session.
    46	  ENDMETHOD.
    47	
    48	  METHOD run.
    49	    " E1: system message is a first-class message, not glued into the task
    50	    mo_session->push_message( iv_role = 'system' iv_content = iv_system ).
    51	    mo_session->push_message( iv_role = 'user'   iv_content = iv_task ).
    52	    mo_session->evt( |session_start task={ iv_task }| ).
    53	
    54	    WHILE mo_session->mv_iterations < iv_max_iterations.
    55	      mo_session->inc_iteration( ).
    56	
    57	      mo_llm->chat(
    58	        EXPORTING
    59	          it_messages   = mo_session->get_messages( )
    60	          iv_tools_json = mo_registry->get_tools_json_openai( )
    61	        IMPORTING
    62	          ev_body   = DATA(lv_body)
    63	          ev_status = DATA(lv_status)
    64	          ev_error  = DATA(lv_error) ).
    65	
    66	      IF lv_error IS NOT INITIAL.
    67	        rs_-ok = abap_false.
    68	        rs_-error = lv_error.
    69	        mo_session->evt( |llm_error { lv_error }| ).
    70	        RETURN.
    71	      ENDIF.
    72	
    73	      DATA(lt_calls) = parse_tool_calls( lv_body ).
    74	
    75	      IF lt_calls IS INITIAL.
    76	        rs_-answer = extract_answer( lv_body ).
    77	        rs_-ok = abap_true.
    78	        rs_-iterations = mo_session->mv_iterations.
    79	        rs_-tool_calls = mo_session->mv_tool_calls.
    80	        mo_session->push_message( iv_role = 'assistant' iv_content = rs_-answer ).
    81	        mo_session->evt( 'turn_complete' ).
    82	        RETURN.
    83	      ENDIF.
    84	
    85	      " assistant tool_calls message (raw JSON convention, see llm_http)
    86	      DATA(lv_raw) = zcl_pia_00_json_util=>extract_balanced(
    87	        iv_json = lv_body iv_key = 'tool_calls' iv_open = '[' iv_close = ']' ).
    88	      mo_session->push_message(
    89	        iv_role = 'assistant'
    90	        iv_content = '{"tool_calls":' && lv_raw && '}' ).
    91	
    92	      LOOP AT lt_calls INTO DATA(ls_call).
    93	        mo_session->inc_tool_call( ).
    94	        mo_session->evt( |tool_started { ls_call-name } { ls_call-arguments }| ).
    95	
    96	        DATA(ls_result) = mo_registry->invoke_call( ls_call ).
    97	
    98	        mo_session->log_tool(
    99	          iv_tool = ls_call-name iv_args = ls_call-arguments
   100	          iv_ok = ls_result-ok iv_output = ls_result-output ).
   101	
   102	        " truncate huge outputs for the model
   103	        DATA(lv_out) = ls_result-output.
   104	        IF strlen( lv_out ) > 8000.
   105	          lv_out = lv_out+0(8000) && '...[truncated]'.
   106	        ENDIF.
   107	
   108	        mo_session->push_message(
   109	          iv_role = 'tool'
   110	          iv_content = '"tool_call_id":"' && ls_call-id &&
   111	                       '","content":"' && zcl_pia_00_json_util=>escape( lv_out ) && '"' ).
   112	
   113	        mo_session->evt( |tool_finished { ls_call-name } ok={ ls_result-ok }| ).
   114	      ENDLOOP.
   115	    ENDWHILE.
   116	
   117	    rs_-ok = abap_true.
   118	    rs_-answer = 'MAX ITERATIONS REACHED'.
   119	    rs_-iterations = mo_session->mv_iterations.
   120	    rs_-tool_calls = mo_session->mv_tool_calls.
   121	  ENDMETHOD.
   122	
   123	  METHOD parse_tool_calls.
   124	    DATA(lv_arr) = zcl_pia_00_json_util=>extract_balanced(
   125	      iv_json = iv_body iv_key = 'tool_calls' iv_open = '[' iv_close = ']' ).
   126	    IF lv_arr IS INITIAL.
   127	      RETURN.
   128	    ENDIF.
   129	    " split top-level entries by matching braces
   130	    DATA lv_pos TYPE i VALUE 0.
   131	    WHILE lv_pos < strlen( lv_arr ).
   132	      FIND FIRST OCCURRENCE OF '{' IN lv_arr+lv_pos MATCH OFFSET DATA(lv_off).
   133	      IF sy-subrc <> 0. EXIT. ENDIF.
   134	      DATA(lv_start) = lv_pos + lv_off.
   135	      DATA lv_depth TYPE i VALUE 1.
   136	      DATA lv_end TYPE i VALUE lv_start.
   137	      WHILE lv_end < strlen( lv_arr ) - 1 AND lv_depth > 0.
   138	        lv_end = lv_end + 1.
   139	        IF lv_arr+lv_end(1) = '{'.
   140	          lv_depth = lv_depth + 1.
   141	        ELSEIF lv_arr+lv_end(1) = '}'.
   142	          lv_depth = lv_depth - 1.
   143	        ENDIF.
   144	      ENDWHILE.
   145	      DATA(lv_len) = lv_end - lv_start + 1.
   146	      DATA(lv_entry) = lv_arr+lv_start(lv_len).
   147	      APPEND VALUE #(
   148	        id        = zcl_pia_00_json_util=>extract_str( iv_json = lv_entry iv_name = 'id' )
   149	        name      = zcl_pia_00_json_util=>extract_str( iv_json = lv_entry iv_name = 'name' )
   150	        arguments = zcl_pia_00_json_util=>extract_balanced(
   151	                      iv_json = lv_entry iv_key = 'arguments' iv_open = '{' iv_close = '}' ) )
   152	        TO rt_.
   153	      IF rt_[ lines( rt_ ) ]-name IS INITIAL.
   154	        DELETE rt_ INDEX lines( rt_ ).
   155	      ENDIF.
   156	      lv_pos = lv_end + 1.
   157	    ENDWHILE.
   158	  ENDMETHOD.
   159	
   160	  METHOD extract_answer.
   161	    " choices[0].message.content (skip empty reasoning models content)
   162	    rv_ = zcl_pia_00_json_util=>extract_str( iv_json = iv_body iv_name = 'content' ).
   163	    IF rv_ IS INITIAL.
   164	      rv_ = iv_body.
   165	    ENDIF.
   166	  ENDMETHOD.
   167	
   168	ENDCLASS.
