===== src/00/zcl_pia_00_registry.clas.abap
     1	CLASS zcl_pia_00_registry DEFINITION PUBLIC FINAL CREATE PUBLIC.
     2	
     3	  PUBLIC SECTION.
     4	    CLASS-METHODS new RETURNING VALUE(ro_) TYPE REF TO zcl_pia_00_registry.
     5	
     6	    METHODS register IMPORTING io_ TYPE REF TO zif_pia_00_tool.
     7	
     8	    METHODS get_tools_json_openai RETURNING VALUE(rv_) TYPE string.
     9	
    10	    METHODS invoke_call
    11	      IMPORTING is_call     TYPE zif_pia_00_tool=>ts_call
    12	      RETURNING VALUE(rs_)  TYPE zif_pia_00_tool=>ts_result.
    13	
    14	    METHODS count RETURNING VALUE(rv_) TYPE i.
    15	
    16	  PRIVATE SECTION.
    17	    DATA mt TYPE STANDARD TABLE OF REF TO zif_pia_00_tool WITH EMPTY KEY.
    18	
    19	ENDCLASS.
    20	
    21	CLASS zcl_pia_00_registry IMPLEMENTATION.
    22	
    23	  METHOD new.
    24	    ro_ = NEW #( ).
    25	  ENDMETHOD.
    26	
    27	  METHOD register.
    28	    IF io_ IS BOUND.
    29	      APPEND io_ TO mt.
    30	    ENDIF.
    31	  ENDMETHOD.
    32	
    33	  METHOD get_tools_json_openai.
    34	    DATA lt TYPE string_table.
    35	    LOOP AT mt INTO DATA(lo).
    36	      DATA lt_p TYPE string_table.
    37	      DATA lt_r TYPE string_table.
    38	      LOOP AT lo->get_params( ) INTO DATA(ls_p).
    39	        APPEND '"' && ls_p-name && '":{"type":"' && ls_p-type &&
    40	               '","description":"' && zcl_pia_00_json_util=>escape( ls_p-desc ) && '"}'
    41	               TO lt_p.
    42	        IF ls_p-required = abap_true.
    43	          APPEND '"' && ls_p-name && '"' TO lt_r.
    44	        ENDIF.
    45	      ENDLOOP.
    46	      DATA(lv_props) = concat_lines_of( table = lt_p sep = ',' ).
    47	      DATA(lv_req)   = concat_lines_of( table = lt_r sep = ',' ).
    48	      APPEND '{"type":"function","function":{"name":"' && lo->get_name( ) &&
    49	             '","description":"' && zcl_pia_00_json_util=>escape( lo->get_description( ) ) &&
    50	             '","parameters":{"type":"object","properties":{' && lv_props &&
    51	             '},"required":[' && lv_req && ']}}}'
    52	             TO lt.
    53	    ENDLOOP.
    54	    rv_ = '[' && concat_lines_of( table = lt sep = ',' ) && ']'.
    55	  ENDMETHOD.
    56	
    57	  METHOD invoke_call.
    58	    LOOP AT mt INTO DATA(lo).
    59	      IF to_upper( lo->get_name( ) ) = to_upper( is_call-name ).
    60	        rs_ = lo->invoke( iv_arguments = is_call-arguments iv_call_id = is_call-id ).
    61	        RETURN.
    62	      ENDIF.
    63	    ENDLOOP.
    64	    rs_-ok = abap_false.
    65	    rs_-output = 'ERROR: tool not found: ' && is_call-name.
    66	    rs_-call_id = is_call-id.
    67	  ENDMETHOD.
    68	
    69	  METHOD count.
    70	    rv_ = lines( mt ).
    71	  ENDMETHOD.
    72	
    73	ENDCLASS.
