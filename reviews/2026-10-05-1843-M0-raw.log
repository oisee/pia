    11	  TYPES: BEGIN OF ts_call,
    12	           id        TYPE string,
    13	           name      TYPE string,
    14	           arguments TYPE string,
    15	         END OF ts_call.
    16	  TYPES tt_calls TYPE STANDARD TABLE OF ts_call WITH EMPTY KEY.
    17	
    18	  TYPES: BEGIN OF ts_result,
    19	           call_id TYPE string,
    20	           ok      TYPE abap_bool,
    21	           output  TYPE string,
    22	         END OF ts_result.
    23	
    24	  CONSTANTS: c_perm_read  TYPE string VALUE 'READ',
    25	             c_perm_write TYPE string VALUE 'WRITE',
    26	             c_perm_exec  TYPE string VALUE 'EXECUTE'.
    27	
    28	  METHODS get_name        RETURNING VALUE(rv_) TYPE string.
    29	  METHODS get_description RETURNING VALUE(rv_) TYPE string.
    30	  METHODS get_params      RETURNING VALUE(rt_) TYPE tt_params.
    31	  METHODS get_permission  RETURNING VALUE(rv_) TYPE string.
    32	  METHODS invoke
    33	    IMPORTING iv_arguments TYPE string
    34	              iv_call_id   TYPE string OPTIONAL
    35	    RETURNING VALUE(rs_)   TYPE ts_result.
    36	
    37	ENDINTERFACE.
