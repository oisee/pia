     5	
     6	CLASS zcl_pia_90_agent_run IMPLEMENTATION.
     7	  METHOD if_oo_adt_classrun~main.
     8	    out->write( `PIA M1: live agent run` ).
     9	
    10	    DATA(lo_backend) = zcl_pia_20_b_osg_store=>new( ).
    11	    DATA(lo_registry) = zcl_pia_00_registry=>new( ).
    12	
    13	    DATA(lo_read) = NEW zcl_pia_10_t_read_object( ).
    14	    lo_read->set_backend( lo_backend ).
    15	    lo_registry->register( lo_read ).
    16	
    17	    DATA(lo_write) = NEW zcl_pia_15_t_write_source( ).
    18	    lo_write->set_backend( lo_backend ).
    19	    lo_registry->register( lo_write ).
    20	
    21	    DATA(lo_act) = NEW zcl_pia_15_t_activate( ).
    22	    lo_act->set_backend( lo_backend ).
    23	    lo_registry->register( lo_act ).
    24	
    25	    DATA(lo_llm) = zcl_pia_00_llm_http=>new( VALUE #(
    26	      base_url = 'http://192.168.8.107:11434/v1/chat/completions'
    27	      model    = 'qwen-coder-abap-v7:latest' ) ).
    28	
    29	    DATA(lo_session) = zcl_pia_00_session=>new( 'fix ADD in ZCL_PIA_DEMO' ).
    30	
    31	    DATA(lo_exec) = zcl_pia_00_executor=>new(
    32	      io_llm      = lo_llm
    33	      io_registry = lo_registry
    34	      io_session  = lo_session ).
    35	
    36	    DATA(ls) = lo_exec->run(
    37	      iv_task = 'Class ZCL_PIA_DEMO: method ADD returns a - b but must return a + b. '
    38	             &&  'Read the class, write the full corrected source, activate it.'
    39	      iv_system = 'You are PIA, an ABAP coding agent running inside an ABAP runtime. '
    40	               && 'Tools: read_object(name), write_source(name, source), activate(name). '
    41	               && 'Rules: read before write; write_source takes the COMPLETE class source; '
    42	               && 'always activate after write; the new code goes live in the NEXT step, '
    43	               && 'so finish with a one-line summary right after activate. Be terse.'
    44	      iv_max_iterations = 8 ).
    45	
    46	    out->write( |ANSWER: { ls-answer }| ).
    47	    out->write( |RESULT: iters={ ls-iterations } tool_calls={ ls-tool_calls } ok={ ls-ok } err={ ls-error }| ).
    48	    out->write( `--- tool trace ---` ).
    49	    LOOP AT lo_session->get_trace( ) INTO DATA(ls_t).
    50	      out->write( |[{ ls_t-tool }] ok={ ls_t-ok }| ).
    51	      out->write( |  args: { ls_t-args }| ).
    52	    ENDLOOP.
    53	  ENDMETHOD.
    54	ENDCLASS.
