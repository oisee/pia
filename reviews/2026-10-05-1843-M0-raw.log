     1	CLASS zcl_pia_probe DEFINITION PUBLIC FINAL CREATE PUBLIC.
     2	  PUBLIC SECTION.
     3	    INTERFACES if_oo_adt_classrun.
     4	  PRIVATE SECTION.
     5	    METHODS https_probe RETURNING VALUE(rv_out) TYPE string.
     6	    METHODS llm_probe    RETURNING VALUE(rv_out) TYPE string.
     7	ENDCLASS.
     8	
     9	CLASS zcl_pia_probe IMPLEMENTATION.
    10	  METHOD if_oo_adt_classrun~main.
    11	    out->write( `PIA probe: start` ).
    12	    TRY.
    13	        out->write( https_probe( ) ).
    14	      CATCH cx_root INTO DATA(lx).
    15	        out->write( |PIA probe: EX https { lx->get_text( ) }| ).
    16	    ENDTRY.
    17	    TRY.
    18	        out->write( llm_probe( ) ).
    19	      CATCH cx_root INTO DATA(lx2).
    20	        out->write( |PIA probe: EX llm { lx2->get_text( ) }| ).
    21	    ENDTRY.
    22	    out->write( `PIA probe: done` ).
    23	  ENDMETHOD.
    24	
    25	  METHOD https_probe.
    26	    DATA li TYPE REF TO if_http_client.
    27	    cl_http_client=>create_by_url(
    28	      EXPORTING url = 'https://api.anthropic.com/v1/messages'
    29	      IMPORTING client = li ).
    30	    li->request->set_method( 'POST' ).
    31	    li->request->set_header_field( name = 'content-type' value = 'application/json' ).
    32	    li->request->set_header_field( name = 'x-api-key' value = 'pia-probe-no-key' ).
    33	    li->request->set_header_field( name = 'anthropic-version' value = '2023-06-01' ).
    34	    li->request->set_cdata(
    35	      '{"model":"claude-3-5-haiku-latest","max_tokens":1,"messages":[{"role":"user","content":"ping"}]}' ).
    36	    li->send( ).
    37	    li->receive( ).
    38	    DATA lv_code TYPE i.
    39	    li->response->get_status( IMPORTING code = lv_code ).
    40	    rv_out = |PIA probe: HTTPS status { lv_code } (expected 401 without key)|.
    41	  ENDMETHOD.
    42	
    43	  METHOD llm_probe.
    44	    DATA li TYPE REF TO if_http_client.
    45	    cl_http_client=>create_by_url(
    46	      EXPORTING url = 'http://192.168.8.107:11434/v1/chat/completions'
    47	      IMPORTING client = li ).
    48	    li->request->set_method( 'POST' ).
    49	    li->request->set_header_field( name = 'content-type' value = 'application/json' ).
    50	    li->request->set_cdata(
    51	      '{"model":"qwen-coder-abap-v7:latest","max_tokens":120,' &&
    52	      ' "messages":[{"role":"user","content":"Write a one-line ABAP statement that concatenates a and b into c."}]}' ).
    53	    li->send( ).
    54	    li->receive( ).
    55	    DATA lv_code TYPE i.
    56	    li->response->get_status( IMPORTING code = lv_code ).
    57	    DATA(lv_body) = li->response->get_cdata( ).
    58	    DATA lv_content TYPE string.
    59	    FIND FIRST OCCURRENCE OF REGEX '"content"\s*:\s*"([^"]*)"' IN lv_body SUBMATCHES lv_content.
    60	    rv_out = |PIA probe: LLM status { lv_code }, model says: { lv_content }|.
    61	  ENDMETHOD.
    62	ENDCLASS.
