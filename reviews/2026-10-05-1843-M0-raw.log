===== osg-probe/pia_warm.sh
     1	#!/bin/bash
     2	BASE=http://localhost:3030/sap/bc/adt
     3	HS=$(curl -s -I -u alice:alice -H "x-csrf-token: fetch" "$BASE/core/discovery")
     4	TOKEN=$(echo "$HS" | grep -i '^x-csrf-token:' | tr -d '\r' | awk '{print $2}')
     5	COOKIE=$(echo "$HS" | grep -i '^set-cookie:' | grep -o 'sap-contextid=[^;]*' | head -1)
     6	H="cookie: $COOKIE"
     7	T="x-csrf-token: $TOKEN"
     8	# 1. lock
     9	HANDLE=$(curl -s -u alice:alice -X POST "$BASE/oo/classes/zcl_pia_probe?_action=LOCK&accessMode=MODIFY" -H "$H" -H "$T" -H "x-sap-adt-sessiontype: stateful" | grep -o '<LOCK_HANDLE>[^<]*' | sed 's/<LOCK_HANDLE>//')
    10	echo "lock handle: ${HANDLE:0:12}..."
    11	# 2. read source, add a comment
    12	curl -s -u alice:alice "$BASE/oo/classes/zcl_pia_probe/source/main" > /tmp/src.abap
    13	echo "* warm touch $(date +%T)" >> /tmp/src.abap
    14	# 3. PUT
    15	T0=$(date +%s.%N)
    16	curl -s -u alice:alice -X PUT "$BASE/oo/classes/zcl_pia_probe/source/main?lockHandle=$HANDLE" -H "$H" -H "$T" -H "x-sap-adt-sessiontype: stateful" --data-binary @/tmp/src.abap -o /dev/null -w "PUT: %{http_code} (%{time_total}s)\n"
    17	# 4. unlock
    18	curl -s -u alice:alice -X POST "$BASE/oo/classes/zcl_pia_probe?_action=UNLOCK&lockHandle=$HANDLE" -H "$H" -H "$T" -o /dev/null -w "unlock: %{http_code}\n"
    19	# 5. activate
    20	curl -s -u alice:alice -X POST "$BASE/activation?method=activate&preauditRequested=true" \
    21	  -H "$H" -H "$T" -H "x-sap-adt-sessiontype: stateful" -H "content-type: application/xml" \
    22	  -d '<?xml version="1.0" encoding="UTF-8"?>
    23	<adtcore:objectReferences xmlns:adtcore="http://www.sap.com/adt/core">
    24	  <adtcore:objectReference adtcore:uri="/sap/bc/adt/oo/classes/zcl_pia_probe" adtcore:name="ZCL_PIA_PROBE"/>
    25	</adtcore:objectReferences>' -o /dev/null -w "activate: %{http_code} (%{time_total}s)\n"
