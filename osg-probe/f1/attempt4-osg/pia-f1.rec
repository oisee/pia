\u003eassert_equals( exp = 'c2' act = ls_call-id msg = 'call 2: id' ).\\\\n    cl_abap_unit_assert=\\u003eassert_equals( exp = 'run_tests' act = ls_call-name msg = 'call 2: name' ).\\\\n    cl_abap_unit_assert=\\u003eassert_equals(\\\\n      exp = `{\\\\\\\"name\\\\\\\":\\\\\\\"ZCL_X\\\\\\\"}`\\\\n      act = ls_call-arguments\\\\n      msg = 'call 2: arguments' ).\\\\n  ENDMETHOD.\\\\n\\\\nENDCLASS.\\\"}\",\"call_id\":\"call_-7227988127292325048\",\"id\":\"fc_call_-7227988127292325048\",\"name\":\"write_source\",\"status\":\"completed\",\"type\":\"function_call\"}],\"parallel_tool_calls\":true,\"previous_response_id\":\"\",\"status\":\"completed\",\"usage\":{\"input_tokens\":11897,\"input_tokens_details\":{\"cached_tokens\":7040},\"output_tokens\":23876,\"output_tokens_details\":{\"reasoning_tokens\":22432},\"total_tokens\":35773}}
